# EduChat 后端配置
# 复制此文件为 .env 并修改对应值

# 模型路径（AutoDL 上模型下载位置）
EDUCHAT_MODEL_PATH=/root/autodl-tmp/EduChat_Project/models/educhat-r1-001-8b-qwen3.0

# 关闭演示模式（AutoDL 上有真实模型时设为 false）
EDUCHAT_DEMO_MODE=false

# 4-bit 量化（节省显存，RTX 4080 SUPER 32GB 建议开启）
USE_4BIT=true

# 生成参数
MAX_NEW_TOKENS=1024
TEMPERATURE=0.3
TOP_P=0.9

# 服务端口
DEPLOY_RUN_PORT=8000
